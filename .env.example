# === Base de données PostgreSQL ===
# Dev : base locale (Postgres Homebrew). Prod : Neon (Settings → Environment Variables sur Vercel).
DATABASE_URL="postgresql://USER@localhost:5432/revenu_disponible?schema=public"

# === Better Auth ===
# Secret d'au moins 32 caractères, haute entropie :  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL de base de l'app — http://localhost:3100 en dev, https://revenu-disponible.vercel.app en prod.
BETTER_AUTH_URL="http://localhost:3100"

# === Google OAuth (optionnel) ===
# Laisser vide pour masquer le bouton « Se connecter avec Google ».
# Callback à enregistrer dans Google Cloud Console :  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Mettre "true" UNIQUEMENT si les deux identifiants ci-dessus sont remplis
# (contrôle l'affichage du bouton Google côté navigateur).
NEXT_PUBLIC_GOOGLE_ENABLED=""
